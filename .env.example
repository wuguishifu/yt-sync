PORT=3000
# Paths to the yt-dlp and ffmpeg binaries (mounted into the container)
YTDLP_PATH=yt-dlp
FFMPEG_PATH=
# Where videos are saved (one subfolder per playlist)
DOWNLOAD_DIR=./downloads
# Working dir for in-progress downloads (keeps partial files out of DOWNLOAD_DIR)
# TEMP_DIR=./data/tmp
# Where the SQLite database lives
DATA_DIR=./data
# Default schedule. Once a schedule is saved in the web UI, the saved one wins.
SYNC_CRON=0 * * * *
# yt-dlp format selector
YTDLP_FORMAT=bv*[ext=mp4]+ba[ext=m4a]/b[ext=mp4]/bv*+ba/b
# Download attempts per video before giving up (use "Retry failed" in the UI to reset)
MAX_ATTEMPTS=3
# Extra args passed to every yt-dlp call. Default enables Node as yt-dlp's JS runtime.
# YTDLP_EXTRA_ARGS=--js-runtimes node:/usr/local/bin/node
# Embed title/date/description/chapters/cover in each mp4 and write a <video>.jpg poster for Plex
# PLEX_METADATA=true
# Number of log entries kept in the database
LOG_RETENTION=10000
